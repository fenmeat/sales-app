{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fenmeat-sales-test",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "APP_ENV": "test"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fenmeat-sales-test",
      "database_id": "c50b5aff-e422-4430-8b51-8237248f9c23",
      "migrations_dir": "migrations"
    }
  ]
}
